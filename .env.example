# Runtime owner credential: used ONLY server-side. Never NEXT_PUBLIC_.
DATABASE_URL=postgresql://agendai_owner:change-me@localhost:5432/agendai
# Optional direct URL for migrations when runtime uses a pooled connection.
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Agendaí
TZ=America/Sao_Paulo
PLATFORM_ADMIN_USER_IDS=
# Email disabled by default. Explicitly enable only after domain validation.
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
SEED_DEMO=false
SEED_PASSWORD=
